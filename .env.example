# Copy to .env and fill in. .env is gitignored and must never be committed.

# ---- LLM ----
LLM_BACKEND=gemini
GEMINI_API_KEY=your-key-from-https://aistudio.google.com/apikey

# Gemini 2.0 models were retired during this project. Run
#   python -m scripts.list_models
# to see what your key can reach; the script ranks them by version.
GEMINI_MODEL=gemini-2.5-flash-lite

# Gemini 2.5+ are "thinking" models: they spend maxOutputTokens on hidden
# reasoning before emitting text, so a small budget returns an EMPTY answer.
# 0 disables it. See docs/FEEDBACK.md, final section.
GEMINI_THINKING_BUDGET=0

# ---- Embeddings ----
# sentence-transformers (default, local, free) | gemini | hashing (offline CI)
EMBEDDER=sentence-transformers
EMBED_MODEL=all-MiniLM-L6-v2

# ---- TigerGraph Savanna ----
# Host: open your workspace in Savanna and copy its URL.
#   looks like https://<workspace-id>.i.tgcloud.io
# Ports are auto-detected for tgcloud hosts (HTTPS 443) - leave them alone.
TG_HOST=https://your-workspace-id.i.tgcloud.io

# The graph name EXACTLY as you created it. Note that naming a *database* in the
# Savanna onboarding flow does NOT create a graph - see docs/FEEDBACK.md #2.
# The GSQL scripts carry a $GRAPH_NAME placeholder substituted with this value.
TG_GRAPH=Tiger_Graph_RAG

# Preferred auth: a DATABASE SECRET. This is NOT the same as a Savanna API key
# (that one is control-plane only and will fail here - docs/FEEDBACK.md #1).
# Create it from the GSQL shell inside your workspace:
#     USE GRAPH Tiger_Graph_RAG
#     CREATE SECRET
TG_SECRET=

# Fallback auth, only if you are not using a secret:
TG_USERNAME=tigergraph
TG_PASSWORD=
TG_TOKEN=
